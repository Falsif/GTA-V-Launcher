{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTA V Launcher",
  "version": "1.0.0",
  "identifier": "com.lunexa.gtavlauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GTA V Launcher",
        "width": 1240,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0b0b0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LUNEXA",
    "copyright": "LUNEXA. Неофициальный проект, не связан с Rockstar Games.",
    "category": "Game",
    "shortDescription": "Неофициальный лаунчер для GTA V",
    "longDescription": "Поиск и запуск GTA V Legacy/Enhanced через официальные клиенты, менеджер модов для одиночного режима, настройки графики, профили.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
